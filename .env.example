# Create .env.local from this file. Obtain this from Google Cloud OAuth credentials.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Server-only secret: set this in Vercel (or in .env.local for `npm run dev`). Never prefix it with VITE_.
OPENTYPHOON_API_KEY=your-opentyphoon-api-key
