# Browser-safe Google OAuth Web Client ID.
# Local Google Authorized JavaScript origin: http://localhost:5173
# Production origin: your final https://*.vercel.app domain and/or custom domain.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-only secret. Set in Vercel Project Settings -> Environment Variables.
# For local development, put it in .env.local. Never prefix this variable with VITE_.
OPENTYPHOON_API_KEY=your-opentyphoon-api-key
